# Homebrew Bundle manifest for the C/C++ developer toolchain. Install with:
#   brew bundle
#
# R dev packages are tracked separately in DESCRIPTION (Config/Needs/*); install
# them with install.packages() or pak::pak(). The Air R formatter is supplied by
# the "Posit.air-vscode" VS Code extension (see .vscode/extensions.json), so it
# is intentionally not listed here.
brew "llvm"   # clang-format, clang-tidy, clangd for the C/C++ sources
brew "bear"   # records compile_commands.json for the clang tooling

/* #define HAVE_ALLOCA_H 1 */
#define HAVE_GETTIMEOFDAY 1
#define HAVE_STDINT_H 1
#define STDC_HEADERS 1
#define HAVE_SYS_TYPES_H 1
#if (defined(_MSC_VER) && _M_IX86_FP >= 2) || defined(__SSE2__) || defined(__ia64) || defined(__x64_64__) || defined(_M_X64) || defined(_M_AMD64)
#  define COMPILER_SUPPORTS_SSE2 1
#  define COMPILER_SUPPORTS_SSE4_1 1
#  define COMPILER_SUPPORTS_AVX 1
#  define COMPILER_SUPPORTS_AVX2 1
#  ifndef __SSE2__
#    define __SSE2__ 1
#  endif
#endif

// Windows on ARM64 (MSVC's _M_ARM64, or a gcc/clang aarch64 mingw toolchain);
// NEON is a mandatory baseline feature of AArch64, so no runtime or configure
// probe is needed, mirroring the unconditional x86_64 case above.
#if defined(_M_ARM64) || defined(__aarch64__)
#  define COMPILER_SUPPORTS_NEON 1
#endif

#define XINT_TYPE uint16_t


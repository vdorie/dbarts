ARCH=$(shell "${R_HOME}/bin/R" --no-echo -e 'cat(R.version$$arch)')
ifeq "$(ARCH)" "x86_64"
  SSE2_FLAG=-msse2
  SSE4_1_FLAG=-msse4.1
  AVX_FLAG=-mavx
  AVX2_FLAG=-mavx2
endif
# Windows on ARM64 (MSVC or an aarch64 mingw toolchain); R.version$arch is
# expected to read "aarch64" there, but the exact string is unverified since
# no Windows-arm64 R build is available to probe - hedge across the spellings
# inst/tinytest/test-simd.R already hedges on (aarch64, arm64, arm).
ifneq (,$(filter aarch64 arm64 arm,$(ARCH)))
  NEON_FLAG=-DCOMPILER_SUPPORTS_NEON
endif

INST_DIR=../inst

PTHREAD_CPPFLAGS=$(SHLIB_PTHREAD_FLAGS)
PTHREAD_LIBS=$(SHLIB_PTHREAD_FLAGS)

# the generalized core (bartcore/) requires C++20; see
# docs/design/core-generalization.md
CXX_STD = CXX20

PKG_CPPFLAGS=-I$(INST_DIR)/include -Iinclude $(PTHREAD_CPPFLAGS)
PKG_LIBS= external.a misc.a rc.a $(PTHREAD_LIBS)

# as in Makevars.in: an empty ARFLAGS would run ar with no operation, so
# fall back to -crs when Makeconf leaves it unset
BOOL,true = true
BOOL,false = false
BOOL, = true
arflags_set.test, = false
arflags_set = $(BOOL,$(arflags_set.test,$(ARFLAGS)))

arflags.true = $(ARFLAGS)
arflags.false = -crs

PKG_ARFLAGS = $(arflags.$(arflags_set))

MkInclude = $(R_HOME)/etc${R_ARCH}/Makeconf

SUBDIRS = external misc rc
SUBLIBS = $(SUBDIRS:=.a)

all: $(SHLIB)

$(SHLIB): sublibs

sublibs:
	@for d in $(SUBDIRS); do \
	  (cd $${d} && $(MAKE) -f "$(MkInclude)" -f Makefile library \
	   PTHREAD_CPPFLAGS="$(PTHREAD_CPPFLAGS)" INST_DIR="$(INST_DIR)" \
           SSE2_FLAG="$(SSE2_FLAG)" SSE4_1_FLAG="$(SSE4_1_FLAG)" AVX_FLAG="$(AVX_FLAG)" AVX2_FLAG="$(AVX2_FLAG)" \
           NEON_FLAG="$(NEON_FLAG)" \
           CC="$(CC)" CFLAGS="$(CFLAGS) $(CPICFLAGS)" CXX="$(CXX)" CXXFLAGS="$(CXXFLAGS) $(CXXPICFLAGS)" \
           CPPFLAGS="$(CPPFLAGS)" AR="$(AR)" ARFLAGS="$(PKG_ARFLAGS)" RANLIB="$(RANLIB)") \
           || exit 1; \
	done

clean: subclean
	@-rm -f include/misc/types.h config.hpp
	@-rm -rf .libs _libs
	@-rm -f *.o $(SHLIB)

subclean:
	@-rm -f *.a
	@for d in $(SUBDIRS); do \
	  (cd $${d} && MkInclude="$(MkInclude)" $(MAKE) clean) || exit 1; \
	done


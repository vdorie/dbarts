+/// SCRATCH STUDY BUILD (nbinom-default-study), never shipped. NBS_KPRIOR
+/// names the prior on k, read at each use: unset or empty for the shipped
+/// chi; "floor:f" for chi(df, scale) truncated to k >= f; "halfnormal:m" for a
+/// half-normal on s = 3 / k with median m. NBS_MOVE=off turns the collapsed
+/// scale move off, so that the build is today's sampler with only its k step.
+struct StudyKPrior {
+  int mode = 0;  // 0 shipped chi, 1 floor, 2 half-normal on 3 / k
+  double value = 0.0;  // the floor, or the half-normal's sigma
+};
 
+inline StudyKPrior readStudyKPrior() {
+  StudyKPrior prior;
+  const char* text = std::getenv("NBS_KPRIOR");
+  if (text == nullptr || *text == '\0') return prior;
+  if (std::strncmp(text, "floor:", 6) == 0) {
+    prior.mode = 1;
+    prior.value = std::atof(text + 6);
+  } else if (std::strncmp(text, "halfnormal:", 11) == 0) {
+    prior.mode = 2;
+    // the median of |N(0, sigma^2)| is sigma qnorm(0.75)
+    prior.value = std::atof(text + 11) / 0.67448975019608174;
+  } else {
+    throw std::runtime_error("NBS_KPRIOR names no prior");
+  }
+  if (!(prior.value > 0.0)) throw std::runtime_error("NBS_KPRIOR value");
+  return prior;
+}
+
+inline bool studyMoveOff() {
+  const char* text = std::getenv("NBS_MOVE");
+  return text != nullptr && std::strcmp(text, "off") == 0;
+}
+
+extern "C" double Rf_pgamma(double, double, double, int, int);
+
+/// k^2 ~ Gamma(shape, rate) truncated to k^2 >= bound, exactly: plain
+/// rejection while the bound keeps at least 5 percent of the mass, else an
+/// exponential proposal from the bound at the log density's slope there, whose
+/// ratio to the target is largest at the bound.
+inline double drawTruncatedGamma(ext_rng* rng, double shape, double rate,
+                                 double bound) {
+  double scale = 1.0 / rate;
+  double logUpper = Rf_pgamma(bound, shape, scale, 0, 1);
+  if (logUpper > std::log(0.05)) {
+    for (;;) {
+      double value = ext_rng_simulateGamma(rng, shape, scale);
+      if (value >= bound) return value;
+    }
+  }
+  // the bound lies above the mode, so the slope is positive
+  double slope = shape > 1.0 ? rate - (shape - 1.0) / bound : rate;
+  for (;;) {
+    double value = bound + ext_rng_simulateExponential(rng, 1.0 / slope);
+    double logAccept = (shape - 1.0) * std::log(value / bound) -
+                       (rate - slope) * (value - bound);
+    if (std::log(ext_rng_simulateContinuousUniform(rng)) <= logAccept)
+      return value;
+  }
+}
+
+/// k's step under the study prior. The shipped chi draws exactly; the floor
+/// draws k^2 from its truncated gamma, exactly; the half-normal takes a slice
+/// step on u = log k from the current k, its log target
+/// (M - 1) u - e^(2u) SS / (2 L^2) - 9 e^(-2u) / (2 sigma^2).
+inline double drawStudyK(ext_rng* rng, const ChiKHyperprior& chi, double k,
+                         double sumSquaredParams, double totalNumLeaves,
+                         double leafScale) {
+  StudyKPrior study = readStudyKPrior();
+  if (study.mode == 0)
+    return chi.draw(rng, sumSquaredParams, totalNumLeaves, leafScale);
+  double leafRate = 0.5 * sumSquaredParams / (leafScale * leafScale);
+  if (study.mode == 1) {
+    double shape = 0.5 * (totalNumLeaves + chi.degreesOfFreedom);
+    double rate = leafRate;
+    if (std::fabs(chi.scale) <= DBL_MAX) rate += 0.5 / (chi.scale * chi.scale);
+    if (!(1.0 / rate <= DBL_MAX)) return HUGE_VAL;
+    return std::sqrt(
+      drawTruncatedGamma(rng, shape, rate, study.value * study.value));
+  }
+  double u0 = std::log(k);
+  double priorRate = 4.5 / (study.value * study.value);
+  auto logDensity = [=](double d) {
+    double u = u0 + d;
+    double square = std::exp(2.0 * u);
+    return (totalNumLeaves - 1.0) * u - leafRate * square - priorRate / square;
+  };
+  return std::exp(u0 + sliceFromZero(rng, logDensity, 0.5, 1000));
+}
